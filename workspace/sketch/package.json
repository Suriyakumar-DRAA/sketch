{
  "name": "@org/sketch",
  "version": "0.0.1",
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "build:prod": "ng-packagr -p ng-package.json --prod",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "peerDependencies": {
    "@angular/common": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "~20.1.0",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "@ng-select/ng-select": "^15.1.3",
    "ngx-bootstrap": "~20.0.0"
  },
  "exports": {
    ".": {
      "import": "./index.mjs",
      "types": "./index.d.ts"
    },
    "./textbox": {
      "import": "./textbox/index.mjs",
      "types": "./textbox/index.d.ts"
    },
    "./dropdown": {
      "import": "./dropdown/index.mjs",
      "types": "./dropdown/index.d.ts"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "textbox/",
    "dropdown/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "module": "fesm2022/sketch.mjs",
  "typings": "index.d.ts",
  "dependencies": {
    "tslib": "^2.3.0"
  }
}